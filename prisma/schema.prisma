generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  createdAt DateTime   @default(now())
  contacts  Contact[]
  campaigns Campaign[]
  auditLogs AuditLog[]
}

model Contact {
  id                   String               @id @default(cuid())
  name                 String
  phone                String               @unique
  email                String?
  groupName            String?
  tags                 String[]             @default([])
  optedOut             Boolean              @default(false)
  marketingOptIn       Boolean              @default(false)
  marketingOptInAt     DateTime?
  marketingOptInSource String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  userId               String?
  user                 User?                @relation(fields: [userId], references: [id])
  messages             Message[]
  audienceMemberships  AudienceMembership[]
  conversation         Conversation?
}

model Campaign {
  id                 String            @id @default(cuid())
  name               String
  message            String
  status             String            @default("draft")
  scheduledAt        DateTime?
  sentAt             DateTime?
  total              Int               @default(0)
  delivered          Int               @default(0)
  read               Int               @default(0)
  failed             Int               @default(0)
  createdAt          DateTime          @default(now())
  userId             String?
  user               User?             @relation(fields: [userId], references: [id])
  messages           Message[]
  accountAssignments CampaignAccount[]
  audienceGroupId    String?
  audienceGroup      AudienceGroup?    @relation(fields: [audienceGroupId], references: [id], onDelete: SetNull)
  templateId         String?
  template           Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

model Template {
  id             String           @id @default(cuid())
  name           String
  body           String
  status         String           @default("draft")
  language       String           @default("en_US")
  category       String           @default("marketing")
  createdAt      DateTime         @default(now())
  metaTemplateId String?          @unique
  accountId      String?
  lastSyncedAt   DateTime?
  account        WhatsAppAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  campaigns      Campaign[]
}

model WhatsAppAccount {
  id                   String            @id @default(cuid())
  name                 String
  phone                String            @unique
  status               String            @default("disconnected")
  phoneNumberId        String?
  businessAccountId    String?
  metaBusinessId       String?
  accessTokenEncrypted String?
  tokenExpiresAt       DateTime?
  connectedAt          DateTime?
  webhookSubscribedAt  DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  campaignAssignments  CampaignAccount[]
  templates            Template[]
}

model CampaignAccount {
  campaignId String
  accountId  String
  assignedAt DateTime        @default(now())
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  account    WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([campaignId, accountId])
  @@index([accountId])
}

model AudienceGroup {
  id          String               @id @default(cuid())
  name        String               @unique
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     AudienceMembership[]
  campaigns   Campaign[]
}

model AudienceMembership {
  groupId   String
  contactId String
  addedAt   DateTime      @default(now())
  group     AudienceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact   Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([groupId, contactId])
  @@index([contactId])
}

model Conversation {
  id            String                @id @default(cuid())
  contactId     String                @unique
  phoneNumberId String?
  status        String                @default("open")
  unreadCount   Int                   @default(0)
  lastMessageAt DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  contact       Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages      ConversationMessage[]

  @@index([status, lastMessageAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  direction      String
  body           String
  status         String       @default("received")
  providerId     String?      @unique
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Message {
  id         String         @id @default(cuid())
  contactId  String
  campaignId String?
  status     String         @default("queued")
  providerId String?        @unique
  error      String?
  sentAt     DateTime?
  createdAt  DateTime       @default(now())
  contact    Contact        @relation(fields: [contactId], references: [id])
  campaign   Campaign?      @relation(fields: [campaignId], references: [id])
  events     MessageEvent[]
}

model MessageEvent {
  id        String   @id @default(cuid())
  messageId String
  status    String
  timestamp DateTime @default(now())
  payload   Json?
  message   Message  @relation(fields: [messageId], references: [id])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}
